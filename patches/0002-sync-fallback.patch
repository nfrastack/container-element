From: Nfrastack <code@nfrastack.com>
Date: Wed, 23 Sep 2026 00:00:00 +0000
Subject: [PATCH] Fix: timeline misses live messages after sync optimization

Bug: Upstream #33268 (v1.12.x) removed the per-sync setState from the
onSync handler to reduce re-renders. Since then, any live event dropped
by onRoomTimeline's early-return branches is never recovered:
  - messagePanel not mounted yet -> `return` without paginating
  - stuckAtBottom false -> set canForwardPaginate, `return` without
    paginating into the TimelineWindow buffer

ClientEvent.Sync only re-renders on PREPARED/CATCHUP transitions, so a
missed event sits in the SDK room timeline but never reaches React
state. Symptom: an open DM shows every message except the newest; the
newest only appears once a further message arrives (off-by-one).

This is triggered easily when stuckAtBottom is misdetected: the 1px
tolerance in ScrollPanel.isAtBottom breaks under tiling WMs (Hyprland),
Electron wrappers (Ferdium) and fractional scaling (see 0003), so a
visually-pinned timeline reports "scrolled up" and every live message
takes the early-return path.

Fix (regenerated against v1.12.29; the previous revision of this patch
no longer applied - hunk FAILED - so the built image shipped unpatched):
1. Always advance the TimelineWindow buffer in onRoomTimeline, even on
   the early-return paths (fire-and-forget paginate, no setState, so a
   genuinely scrolled-up view is preserved).
2. Steady-state sync recovery: on SYNCING pulses, if we know forward
   history exists, paginate it into the window and reloadEvents() once
   the paginate completes (correctly chained via .then(), not read
   synchronously before the paginate lands).
3. visibilitychange + window focus safety net for paints deferred while
   a tab was hidden/unfocused (common under Ferdium).

diff --git a/apps/web/src/components/structures/TimelinePanel.tsx b/apps/web/src/components/structures/TimelinePanel.tsx
index b19d394..9c2f21d 100644
--- a/apps/web/src/components/structures/TimelinePanel.tsx
+++ b/apps/web/src/components/structures/TimelinePanel.tsx
@@ -312,6 +312,10 @@ class TimelinePanel extends React.Component<IProps, IState> {
         cli.on(MatrixEventEvent.Decrypted, this.onEventDecrypted);
         cli.on(MatrixEventEvent.Replaced, this.onEventReplaced);
         cli.on(ClientEvent.Sync, this.onSync);
+        // NFRAPATCH: browsers/Electron throttle background tabs and may defer
+        // paints while hidden. Re-sync the view when the user comes back.
+        document.addEventListener("visibilitychange", this.onPageVisibilityChange);
+        window.addEventListener("focus", this.onWindowFocus);
 
         this.props.timelineSet.room?.on(ThreadEvent.Update, this.onThreadUpdate);
 
@@ -375,6 +379,9 @@ class TimelinePanel extends React.Component<IProps, IState> {
         }
 
         dis.unregister(this.dispatcherRef);
+        // NFRAPATCH: paired with the listeners added in componentDidMount.
+        document.removeEventListener("visibilitychange", this.onPageVisibilityChange);
+        window.removeEventListener("focus", this.onWindowFocus);
 
         const client = MatrixClientPeg.get();
         if (client) {
@@ -691,13 +698,27 @@ class TimelinePanel extends React.Component<IProps, IState> {
         // updates from pagination will happen when the paginate completes.
         if (toStartOfTimeline || !data || !data.liveEvent) return;
 
-        if (!this.messagePanel.current?.getScrollState()) return;
+        if (!this.messagePanel.current?.getScrollState()) {
+            // NFRAPATCH: panel not mounted yet (or torn down during room
+            // switch). Advance the TimelineWindow buffer fire-and-forget so
+            // the event is not lost; the next load/reload picks it up.
+            // Deliberately no reloadEvents() here: there is nothing to render
+            // into yet.
+            void this.timelineWindow?.paginate(EventTimeline.FORWARDS, 1, false);
+            return;
+        }
 
         if (!this.messagePanel.current.getScrollState()?.stuckAtBottom) {
             // we won't load this event now, because we don't want to push any
             // events off the other end of the timeline. But we need to note
             // that we can now paginate.
             this.setState({ canForwardPaginate: true });
+            // NFRAPATCH: still advance the TimelineWindow buffer so the event
+            // is not dropped from the window. React state stays untouched
+            // (preserving the scrolled-up view); the buffered event is
+            // rendered on the next forward-fill / jump-to-bottom / sync
+            // recovery pass.
+            void this.timelineWindow?.paginate(EventTimeline.FORWARDS, 1, false);
             return;
         }
 
@@ -909,10 +930,45 @@ class TimelinePanel extends React.Component<IProps, IState> {
     private onSync = (clientSyncState: SyncState, prevState: SyncState | null, data?: object): void => {
         if (this.unmounted) return;
         const nextSyncImpliesForwardPaginating = TimelinePanel.isSyncForwardPaginating(clientSyncState);
-        if (nextSyncImpliesForwardPaginating === this.syncImpliesForwardPaginating) return;
+        if (nextSyncImpliesForwardPaginating !== this.syncImpliesForwardPaginating) {
+            this.syncImpliesForwardPaginating = nextSyncImpliesForwardPaginating;
+            this.forceUpdate();
+            return;
+        }
+        // NFRAPATCH: steady-state recovery for live events missed while
+        // scrolled up (or while stuckAtBottom was misdetected, e.g. 1px
+        // tolerance under fractional scaling). Upstream #33268 removed the
+        // per-sync setState, so without this nothing re-renders/paginates
+        // until the next PREPARED/CATCHUP transition. If we know forward
+        // history exists, pull it into the window and re-render once the
+        // paginate completes.
+        if (
+            clientSyncState === SyncState.Syncing &&
+            this.state.canForwardPaginate &&
+            !this.state.forwardPaginating &&
+            this.timelineWindow?.canPaginate(EventTimeline.FORWARDS)
+        ) {
+            void this.timelineWindow.paginate(EventTimeline.FORWARDS, 1, false).then(() => {
+                if (this.unmounted) return;
+                this.reloadEvents();
+            });
+        }
+    };
 
-        this.syncImpliesForwardPaginating = nextSyncImpliesForwardPaginating;
-        this.forceUpdate();
+    // NFRAPATCH: safety net for paints the browser deferred while the tab
+    // was hidden / the window unfocused (common under Electron wrappers
+    // like Ferdium). reloadEvents() re-reads the already-advanced
+    // TimelineWindow buffer into React state.
+    private onPageVisibilityChange = (): void => {
+        if (this.unmounted) return;
+        if (document.visibilityState === "visible") {
+            this.reloadEvents();
+        }
+    };
+
+    private onWindowFocus = (): void => {
+        if (this.unmounted) return;
+        this.reloadEvents();
     };
 
     private static isSyncForwardPaginating(syncState: SyncState | null): boolean {
