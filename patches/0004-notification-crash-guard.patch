@@ -348,6 +348,10 @@ export default class ElectronPlatform extends BasePlatform {
 
         const notification = super.displayNotification(title, msg, avatarUrl, room, ev);
 
+        // NFRAPATCH: the base implementation returns null when the
+        // Notification API is broken (see BasePlatform); just skip the popup.
+        if (!notification) return null;
+
         const handler = notification.onclick as () => void;
         notification.onclick = (): void => {
             handler?.();
