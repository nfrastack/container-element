+// NFRAPATCH: spec-stable bodies (conditions/pattern) for the server-default
+// rules, used to (re)create them when a homeserver does not have them and
+// setPushRuleEnabled/setPushRuleActions therefore 404 with M_NOT_FOUND.
+// Actions/enabled always come from the reconciled diff, so the created rule
+// converges to exactly what the settings UI asked for.
+function standardRuleTemplate(
+    ruleId: string,
+    kind: PushRuleKind,
+    userId: string,
+    localpart: string,
+): Pick<IPushRule, "conditions" | "pattern"> | null {
+    if (kind === PushRuleKind.Override) {
+        switch (ruleId) {
+            case RuleId.Master:
+                return { conditions: [] };
+            case RuleId.SuppressNotices:
+                return {
+                    conditions: [
+                        { kind: ConditionKind.EventMatch, key: "content.msgtype", pattern: "m.notice" },
+                    ],
+                };
+            case RuleId.InviteToSelf:
+                return {
+                    conditions: [
+                        { kind: ConditionKind.EventMatch, key: "type", pattern: "m.room.member" },
+                        { kind: ConditionKind.EventMatch, key: "content.membership", pattern: "invite" },
+                        { kind: ConditionKind.EventMatch, key: "state_key", pattern: userId },
+                    ],
+                };
+            case RuleId.MemberEvent:
+                return {
+                    conditions: [{ kind: ConditionKind.EventMatch, key: "type", pattern: "m.room.member" }],
+                };
+            case RuleId.ContainsDisplayName:
+                return { conditions: [{ kind: ConditionKind.ContainsDisplayName }] };
+            case RuleId.AtRoomNotification:
+                return {
+                    conditions: [
+                        { kind: ConditionKind.EventMatch, key: "content.body", pattern: "@room" },
+                        { kind: ConditionKind.SenderNotificationPermission, key: "room" },
+                    ],
+                };
+            case RuleId.Tombstone:
+                return {
+                    conditions: [
+                        { kind: ConditionKind.EventMatch, key: "type", pattern: "m.room.tombstone" },
+                        { kind: ConditionKind.EventMatch, key: "state_key", pattern: "" },
+                    ],
+                };
+            default:
+                return null;
+        }
+    }
+    if (kind === PushRuleKind.ContentSpecific && ruleId === RuleId.ContainsUserName) {
+        return { pattern: localpart };
+    }
+    if (kind === PushRuleKind.Underride) {
+        switch (ruleId) {
+            case RuleId.Message:
+                return {
+                    conditions: [{ kind: ConditionKind.EventMatch, key: "type", pattern: "m.room.message" }],
+                };
+            case RuleId.EncryptedMessage:
+                return {
+                    conditions: [{ kind: ConditionKind.EventMatch, key: "type", pattern: "m.room.encrypted" }],
+                };
+            case RuleId.DM:
+                return {
+                    conditions: [
+                        { kind: ConditionKind.RoomMemberCount, is: "2" },
+                        { kind: ConditionKind.EventMatch, key: "type", pattern: "m.room.message" },
+                    ],
+                };
+            case RuleId.EncryptedDM:
+                return {
+                    conditions: [
+                        { kind: ConditionKind.RoomMemberCount, is: "2" },
+                        { kind: ConditionKind.EventMatch, key: "type", pattern: "m.room.encrypted" },
+                    ],
+                };
+            default:
+                return null;
+        }
+    }
+    return null;
+}
+
+async function applyUpdate(cli: MatrixClient, change: PushRuleUpdate): Promise<void> {
+    try {
+        if (change.enabled !== undefined) {
+            await cli.setPushRuleEnabled("global", change.kind, change.rule_id, change.enabled);
+        }
+        if (change.actions !== undefined) {
+            await cli.setPushRuleActions("global", change.kind, change.rule_id, change.actions);
+        }
+    } catch (err) {
+        // NFRAPATCH: the rule does not exist server-side (some homeservers
+        // lack server-default rules such as .m.rule.contains_display_name, so
+        // enabling them 404s with M_NOT_FOUND and no notification setting can
+        // ever be saved). Recreate the rule from its standard template, then
+        // apply the requested enabled/actions on top of it.
+        const userId = cli.getUserId();
+        const localpart = cli.getUserIdLocalpart();
+        const template =
+            userId && localpart ? standardRuleTemplate(change.rule_id, change.kind, userId, localpart) : null;
+        if ((err as { errcode?: string })?.errcode !== "M_NOT_FOUND" || !template) {
+            throw err;
+        }
+        logger.warn(`Push rule ${change.rule_id} missing server-side; creating it`, err);
+        await cli.addPushRule("global", change.kind, change.rule_id as Exclude<string, RuleId>, {
+            actions: change.actions ?? [],
+            ...template,
+        });
+        if (change.enabled !== undefined) {
+            await cli.setPushRuleEnabled("global", change.kind, change.rule_id, change.enabled);
+        }
+        if (change.actions !== undefined) {
+            await cli.setPushRuleActions("global", change.kind, change.rule_id, change.actions);
+        }
+    }
+}
